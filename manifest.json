    { id: 'puente-propio-peso', name: 'Puente con propio peso', machine: 'Peso corporal', type: 'corporal' },
    { id: 'puentes-una-pierna', name: 'Puentes a una pierna', machine: 'Peso corporal', type: 'corporal' },
    { id: 'salto-rodillas-pecho', name: 'Salto Rodillas al Pecho', machine: 'Peso corporal', type: 'corporal' },
    { id: 'sentadilla', name: 'Sentadilla', machine: 'Barra', type: 'libre' },
    { id: 'sentadilla-bulgara-barra', name: 'Sentadilla búlgara con barra', machine: 'Barra', type: 'libre' },
    { id: 'sentadilla-bulgara-propio-peso', name: 'Sentadilla búlgara con propio peso', machine: 'Peso corporal', type: 'corporal' },
    { id: 'sentadilla-mini-banda', name: 'Sentadilla con mini banda', machine: 'Banda elástica', type: 'corporal' },
    { id: 'sentadilla-salto', name: 'Sentadilla con salto', machine: 'Peso corporal', type: 'corporal' },
    { id: 'sentadilla-frontal', name: 'Sentadilla frontal', machine: 'Barra', type: 'libre' },
    { id: 'sentadilla-goblet-mancuerna', name: 'Sentadilla Goblet con mancuerna', machine: 'Mancuerna', type: 'libre' },
    { id: 'sentadilla-hack', name: 'Sentadilla Hack', machine: 'Máquina', type: 'maquina' },
    { id: 'sentadilla-isometrica-pared', name: 'Sentadilla isométrica apoyado sobre la pared', machine: 'Peso corporal', type: 'corporal' },
    { id: 'sentadilla-posturas-funcionales', name: 'Sentadilla Posturas funcionales', machine: 'Peso corporal', type: 'corporal' },
    { id: 'sentadilla-sumo-kettlebell', name: 'Sentadilla sumo con kettlebell', machine: 'Kettlebell', type: 'libre' },
    { id: 'sentadillas-balon-medicinal', name: 'Sentadillas con balón medicinal', machine: 'Balón medicinal', type: 'libre' },
    { id: 'sentadillas-propio-peso', name: 'Sentadillas con propio peso', machine: 'Peso corporal', type: 'corporal' },
    { id: 'step-up-mancuernas', name: 'Step Up con mancuernas', machine: 'Mancuernas', type: 'libre' },
    { id: 'zancada', name: 'Zancada', machine: 'Mancuernas', type: 'libre' },
  ]},
  { id: 'gemelos', name: 'Gemelos', exercises: [
    { id: 'elevacion-gemelos-pie', name: 'Elevación de gemelos de pie', machine: 'Máquina', type: 'maquina' },
    { id: 'elevacion-gemelos-sentado', name: 'Elevación de gemelos sentado', machine: 'Máquina', type: 'maquina' },
  ]},
];
const TYPE_LABELS = { maquina: 'Máquina', libre: 'Peso libre', corporal: 'Peso corporal · sin máquina' };

const rep3 = (w, r) => [{ weight: w, reps: r }, { weight: w, reps: r }, { weight: w, reps: r }];
const SEED_SETS = {
  'peck-deck': [
    { date: '26 jul', sets: rep3(40, 10) },
    { date: '21 jul', sets: rep3(37.5, 10) },
    { date: '18 jul', sets: rep3(37.5, 8) },
    { date: '14 jul', sets: rep3(35, 8) },
  ],
};
const defaultMultiRows = () => [{ weight: '', reps: '' }, { weight: '', reps: '' }];

const DAY_DEFS = [
  { key: 'mon', label: 'Lunes', short: 'Lun' },
  { key: 'tue', label: 'Martes', short: 'Mar' },
  { key: 'wed', label: 'Miércoles', short: 'Mié' },
  { key: 'thu', label: 'Jueves', short: 'Jue' },
  { key: 'fri', label: 'Viernes', short: 'Vie' },
  { key: 'sat', label: 'Sábado', short: 'Sáb' },
  { key: 'sun', label: 'Domingo', short: 'Dom' },
];
const ALL_EXERCISES_FLAT = GROUPS_DATA.flatMap(g => g.exercises.map(ex => ({ id: ex.id, name: ex.name, groupName: g.name })));

class Component extends DCLogic {
  state = {
    tab: 'home', groupId: null, exerciseId: null,
    setsByExercise: SEED_SETS,
    form: { weight: '40', reps: '10', series: '3' },
    justPr: false, unit: 'kg', navSeq: 0,
    weekPlan: {}, pickerDay: null,
    logMode: 'linear', multiRows: defaultMultiRows(),
    transferMsg: null,
    onboardStep: null, tutStep: 1, formError: null,
    profile: { name: '', weight: '', height: '', age: '', goal: 'ganar' },
    workoutActive: false, workoutSteps: [], workoutStepIndex: 0, workoutPhase: 'set',
    restMinutes: 1.5, restRemaining: 0, workoutCollected: {},
    restCustomActive: false, customMin: '', customSec: '30',
    customExercises: {}, addFormGroupId: null, addForm: { name: '', machine: '', type: 'maquina' },
    favorites: {}, exerciseNotes: {}, exerciseNotesSeed: {},
    heroIndex: 0, heroDragPx: 0, heroDragging: false,
    viewportMode: 'desktop',
  };

  fileInputRef = React.createRef();
  restInterval = null;

  componentWillUnmount() {
    if (this.restInterval) clearInterval(this.restInterval);
    if (this._updateViewportMode) window.removeEventListener('resize', this._updateViewportMode);
  }

  computeShellStyles(mode) {
    if (mode === 'device') {
      return {
        outer: "min-height:100vh;background:#F6E7E2;display:flex;align-items:center;justify-content:center;padding:0;font-family:'Figtree',system-ui,sans-serif;box-sizing:border-box",
        bezel: "width:100%;height:100vh;border-radius:0;background:transparent;padding:0;box-shadow:none;flex:none",
        screen: "position:relative;width:100%;height:100%;border-radius:0;background:#F6E7E2;overflow:hidden;display:flex;flex-direction:column",
      };
    }
    return {
      outer: "min-height:100vh;background:#EFE6E1;display:flex;align-items:center;justify-content:center;padding:48px;font-family:'Figtree',system-ui,sans-serif;box-sizing:border-box",
      bezel: "width:380px;height:800px;border-radius:48px;background:#2E2A2C;padding:12px;box-shadow:0 30px 70px rgba(46,42,44,.28);flex:none",
      screen: "position:relative;width:100%;height:100%;border-radius:38px;background:#F6E7E2;overflow:hidden;display:flex;flex-direction:column",
    };
  }

  startWorkout(steps) {
    this.setState({ workoutActive: true, workoutSteps: steps, workoutStepIndex: 0, workoutPhase: 'set', workoutCollected: {} });
  }

  completeSet() {
    const step = this.state.workoutSteps[this.state.workoutStepIndex];
    if (!step) return;
    const collected = Object.assign({}, this.state.workoutCollected);
    const arr = collected[step.exerciseId] ? collected[step.exerciseId].slice() : [];
    arr.push({ weight: step.weight, reps: step.reps });
    collected[step.exerciseId] = arr;
    this.setState({ workoutCollected: collected, workoutPhase: 'choice' });
  }

  advanceStepOrFinish() {
    if (this.state.workoutStepIndex < this.state.workoutSteps.length - 1) {
      this.setState({ workoutStepIndex: this.state.workoutStepIndex + 1, workoutPhase: 'set' });
    } else {
      this.finishWorkout();
    }
  }

  chooseRest() { this.setState({ workoutPhase: 'restPick' }); }
  setRestMinutes(v) { this.setState({ restMinutes: v, restCustomActive: false }); }
  activateCustomRest() { this.setState({ restCustomActive: true }); }
  setCustomMin(v) { this.setState({ customMin: v }); }
  setCustomSec(v) { this.setState({ customSec: v }); }

  startRestCountdown() {
    const seconds = this.state.restCustomActive
      ? Math.max(5, (parseInt(this.state.customMin) || 0) * 60 + (parseInt(this.state.customSec) || 0))
      : Math.round(this.state.restMinutes * 60);
    this.setState({ workoutPhase: 'restRunning', restRemaining: seconds });
    this.restInterval = setInterval(() => {
      const next = this.state.restRemaining - 1;
      if (next <= 0) {
        clearInterval(this.restInterval); this.restInterval = null;
        this.setState({ restRemaining: 0 });
        this.advanceStepOrFinish();
      } else {
        this.setState({ restRemaining: next });
      }
    }, 1000);
  }

  skipRest() {
    if (this.restInterval) { clearInterval(this.restInterval); this.restInterval = null; }
    this.advanceStepOrFinish();
  }

  finishWorkout() {
    const nextSets = Object.assign({}, this.state.setsByExercise);
    Object.keys(this.state.workoutCollected).forEach(exId => {
      const sets = this.state.workoutCollected[exId];
      if (!sets.length) return;
      const existing = nextSets[exId] || [];
      nextSets[exId] = [{ date: 'Hoy', sets }, ...existing];
    });
    this.setState({ setsByExercise: nextSets, workoutPhase: 'complete' });
    this.persist(nextSets);
  }

  exitWorkout() {
    if (this.restInterval) { clearInterval(this.restInterval); this.restInterval = null; }
    this.setState({ workoutActive: false, workoutPhase: 'set', workoutStepIndex: 0, workoutCollected: {} });
  }

  persistCustom(custom) {
    try { localStorage.setItem('gymapp_custom_exercises_v1', JSON.stringify(custom)); } catch (e) {}
  }

  openAddForm(groupId) { this.setState({ addFormGroupId: groupId, addForm: { name: '', machine: '', type: 'maquina' } }); }
  closeAddForm() { this.setState({ addFormGroupId: null }); }
  setAddFormField(field, val) { this.setState({ addForm: Object.assign({}, this.state.addForm, { [field]: val }) }); }

  saveCustomExercise(groupId) {
    const f = this.state.addForm;
    if (!f.name.trim()) return;
    const ex = { id: `custom-${Date.now()}`, name: f.name.trim(), machine: f.machine.trim() || TYPE_LABELS[f.type], type: f.type, isCustom: true };
    const current = this.state.customExercises[groupId] || [];
    const next = Object.assign({}, this.state.customExercises, { [groupId]: [...current, ex] });
    this.setState({ customExercises: next, addFormGroupId: null });
    this.persistCustom(next);
  }

  removeCustomExercise(groupId, exId) {
    const current = this.state.customExercises[groupId] || [];
    const next = Object.assign({}, this.state.customExercises, { [groupId]: current.filter(e => e.id !== exId) });
    this.setState({ customExercises: next });
    this.persistCustom(next);
  }

  submitProfileForm() {
    if (!this.state.profile.name.trim()) { this.setState({ formError: 'Cuéntanos al menos tu nombre.' }); return; }
    try { localStorage.setItem('gymapp_profile_v1', JSON.stringify(this.state.profile)); } catch (e) {}
    this.setState({ onboardStep: 'tutorial', tutStep: 1, formError: null });
  }

  nextTutStep() {
    if (this.state.tutStep < 5) this.setState({ tutStep: this.state.tutStep + 1 });
    else this.setState({ onboardStep: 'final' });
  }

  prevTutStep() { this.setState({ tutStep: Math.max(1, this.state.tutStep - 1) }); }
  skipTutorial() { this.setState({ onboardStep: 'final' }); }
  replayTutorial() { this.setState({ onboardStep: 'tutorial', tutStep: 1 }); }

  finishOnboarding() {
    try { localStorage.setItem('gymapp_onboarded_v1', 'true'); } catch (e) {}
    this.setState({ onboardStep: null });
  }

  exportProgress() {
    const payload = JSON.stringify({ sets: this.state.setsByExercise, week: this.state.weekPlan, unit: this.state.unit }, null, 2);
    const blob = new Blob([payload], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'mi-progreso-gym.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
    this.setState({ transferMsg: { ok: true, text: 'Archivo generado. Envíalo a tu otro dispositivo.' } });
    setTimeout(() => this.setState({ transferMsg: null }), 4000);
  }

  triggerImport() { if (this.fileInputRef.current) this.fileInputRef.current.click(); }

  handleImportFile(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result);
        const cleanSets = {};
        Object.keys(data.sets || {}).forEach(id => {
          cleanSets[id] = (data.sets[id] || []).filter(sn => sn && Array.isArray(sn.sets) && sn.sets.length > 0);
        });
        const nextSets = Object.assign({}, SEED_SETS, cleanSets);
        const nextWeek = data.week || {};
        this.setState({ setsByExercise: nextSets, weekPlan: nextWeek, unit: data.unit || this.state.unit, transferMsg: { ok: true, text: 'Progreso importado correctamente.' } });
        this.persist(nextSets); this.persistWeek(nextWeek);
      } catch (err) {
        this.setState({ transferMsg: { ok: false, text: 'El archivo no es válido.' } });
      }
      setTimeout(() => this.setState({ transferMsg: null }), 4000);
    };
    reader.readAsText(file);
    e.target.value = '';
  }

  componentDidMount() {
    try {
      const saved = JSON.parse(localStorage.getItem('gymapp_sets_v2') || 'null');
      if (saved) {
        const clean = {};
        Object.keys(saved).forEach(id => {
          const sessions = Array.isArray(saved[id]) ? saved[id] : [];
          clean[id] = sessions.filter(sn => sn && Array.isArray(sn.sets) && sn.sets.length > 0);
        });
        this.setState({ setsByExercise: Object.assign({}, SEED_SETS, clean) });
      }
    } catch (e) {}
    try {
      const savedWeek = JSON.parse(localStorage.getItem('gymapp_week_v1') || 'null');
      if (savedWeek) this.setState({ weekPlan: savedWeek });
    } catch (e) {}
    try {
      const savedProfile = JSON.parse(localStorage.getItem('gymapp_profile_v1') || 'null');
      if (savedProfile) this.setState({ profile: Object.assign({}, this.state.profile, savedProfile) });
    } catch (e) {}
    try {
      const onboarded = localStorage.getItem('gymapp_onboarded_v1') === 'true';
      if (!onboarded) this.setState({ onboardStep: 'form' });
    } catch (e) {}
    try {
      const savedCustom = JSON.parse(localStorage.getItem('gymapp_custom_exercises_v1') || 'null');
      if (savedCustom) this.setState({ customExercises: savedCustom });
    } catch (e) {}
    try {
      const savedFav = JSON.parse(localStorage.getItem('gymapp_favorites_v1') || 'null');
      if (savedFav) this.setState({ favorites: savedFav });
    } catch (e) {}
    try {
      const savedNotes = JSON.parse(localStorage.getItem('gymapp_exercise_notes_v1') || 'null');
      if (savedNotes) this.setState({ exerciseNotes: savedNotes });
    } catch (e) {}
    import('./exercise-notes.js').then(m => this.setState({ exerciseNotesSeed: m.EXERCISE_NOTES || {} })).catch(() => {});
    this._updateViewportMode = () => {
      let standalone = false;
      try { standalone = window.matchMedia && window.matchMedia('(display-mode: standalone)').matches; } catch (e) {}
      const narrow = window.innerWidth <= 640;
      const mode = (standalone || narrow) ? 'device' : 'desktop';
      if (mode !== this.state.viewportMode) this.setState({ viewportMode: mode });
    };
    this._updateViewportMode();
    window.addEventListener('resize', this._updateViewportMode);
  }

  toggleFavorite(exId) {
    const next = Object.assign({}, this.state.favorites);
    if (next[exId]) delete next[exId]; else next[exId] = true;
    this.setState({ favorites: next });
    try { localStorage.setItem('gymapp_favorites_v1', JSON.stringify(next)); } catch (e) {}
  }

  updateExerciseNote(exId, field, value) {
    if (!exId) return;
    const current = this.state.exerciseNotes[exId] || { posInicial: '', ejecucion: '' };
    const next = Object.assign({}, this.state.exerciseNotes, { [exId]: Object.assign({}, current, { [field]: value }) });
    this.setState({ exerciseNotes: next });
    try { localStorage.setItem('gymapp_exercise_notes_v1', JSON.stringify(next)); } catch (e) {}
  }

  heroPointerDown(e) {
    this._heroStartX = e.clientX;
    this.setState({ heroDragging: true, heroDragPx: 0 });
  }

  heroPointerMove(e) {
    if (!this.state.heroDragging) return;
    this.setState({ heroDragPx: e.clientX - this._heroStartX });
  }

  heroPointerUp() {
    const s = this.state;
    if (!s.heroDragging) return;
    const threshold = 50;
    let idx = s.heroIndex;
    if (s.heroDragPx <= -threshold && idx < 1) idx += 1;
    else if (s.heroDragPx >= threshold && idx > -1) idx -= 1;
    this.setState({ heroDragging: false, heroDragPx: 0, heroIndex: idx });
  }

  persist(sets) {
    try { localStorage.setItem('gymapp_sets_v2', JSON.stringify(sets)); } catch (e) {}
  }

  persistWeek(plan) {
    try { localStorage.setItem('gymapp_week_v1', JSON.stringify(plan)); } catch (e) {}
  }

  addToDay(dayKey, ex) {
    const current = this.state.weekPlan[dayKey] || [];
    if (current.some(e => e.id === ex.id)) { this.setState({ pickerDay: null }); return; }
    const next = Object.assign({}, this.state.weekPlan, { [dayKey]: [...current, { id: ex.id, name: ex.name }] });
    this.setState({ weekPlan: next, pickerDay: null });
    this.persistWeek(next);
  }

  removeFromDay(dayKey, exId) {
    const current = this.state.weekPlan[dayKey] || [];
    const next = Object.assign({}, this.state.weekPlan, { [dayKey]: current.filter(e => e.id !== exId) });
    this.setState({ weekPlan: next });
    this.persistWeek(next);
  }

  updateMultiRow(i, field, val) {
    const rows = this.state.multiRows.map((r, idx) => idx === i ? Object.assign({}, r, { [field]: val }) : r);
    this.setState({ multiRows: rows });
  }

  addMultiRow() { this.setState({ multiRows: [...this.state.multiRows, { weight: '', reps: '' }] }); }

  removeMultiRow(i) {
    if (this.state.multiRows.length <= 1) return;
    this.setState({ multiRows: this.state.multiRows.filter((_, idx) => idx !== i) });
  }

  findGroup(id) { return GROUPS_DATA.find(g => g.id === id) || null; }
  findExercise(group, id) { return group ? group.exercises.find(e => e.id === id) : null; }

  renderVals() {
    const s = this.state;
    const groupObj = this.findGroup(s.groupId);
    const combinedExercises = groupObj ? [...groupObj.exercises, ...(s.customExercises[groupObj.id] || [])] : [];
    const exerciseObj = combinedExercises.find(e => e.id === s.exerciseId) || null;

    const groups = GROUPS_DATA.map((g, i) => ({
      name: g.name, count: g.exercises.length + (s.customExercises[g.id] || []).length,
      imgId: `group-${g.id}`,
      open: () => this.setState({ tab: 'exercises', groupId: g.id, exerciseId: null, navSeq: s.navSeq + 1 }),
    }));

    const sortedExercises = combinedExercises.slice().sort((a, b) => (s.favorites[b.id] ? 1 : 0) - (s.favorites[a.id] ? 1 : 0));
    const exercisesForGroup = sortedExercises.map(ex => ({
      id: ex.id, name: ex.name, machine: ex.machine, tag: ex.tag || ex.name.slice(0, 10),
      thumbId: `ex-hero-${ex.id}`,
      typeLabel: TYPE_LABELS[ex.type || 'maquina'], isCustom: !!ex.isCustom,
      favFill: s.favorites[ex.id] ? '#B56576' : 'none',
      toggleFav: () => this.toggleFavorite(ex.id),
      open: () => this.setState({ exerciseId: ex.id, navSeq: s.navSeq + 1, logMode: 'linear', multiRows: defaultMultiRows(), heroIndex: 0, heroDragPx: 0, heroDragging: false }),
      remove: ex.isCustom ? () => this.removeCustomExercise(groupObj.id, ex.id) : null,
    }));
    const isAddFormOpenHere = groupObj && s.addFormGroupId === groupObj.id;

    const unitLabel = s.unit === 'kg' ? 'kg' : 'lb';
    const rawSessions = (exerciseObj && s.setsByExercise[exerciseObj.id]) || [];
    const sessions = rawSessions.filter(sn => sn && Array.isArray(sn.sets) && sn.sets.length > 0);
    const sessionWeightLabel = session => {
      const ws = session.sets.map(x => x.weight);
      return ws.every(w => w === ws[0]) ? `${ws[0]} ${unitLabel}` : `${Math.min(...ws)}-${Math.max(...ws)} ${unitLabel}`;
    };
    const sessionRepsLabel = session => {
      const rs = session.sets.map(x => x.reps);
      return rs.every(r => r === rs[0]) ? `${rs[0]}×${session.sets.length}` : rs.join('-') + ' reps';
    };
    const historyRows = sessions.slice(0, 4).map(session => ({
      date: session.date, weightLabel: sessionWeightLabel(session), repsSeries: sessionRepsLabel(session),
    }));
    const chronological = sessions.slice(0, 6).slice().reverse();
    const maxW = Math.max(1, ...chronological.map(session => Math.max(...session.sets.map(x => x.weight))));
    const colors = ['#E4A3B3', '#E4A3B3', '#d99aa8', '#c9808f', '#b56576', '#9c4f60'];
    const bars = chronological.map((session, i) => ({
      height: Math.max(18, Math.round((Math.max(...session.sets.map(x => x.weight)) / maxW) * 100)) + '%',
      color: colors[Math.min(i, colors.length - 1)],
    }));
    while (bars.length < 1) bars.push({ height: '10%', color: '#E4A3B3' });

    const allPrs = Object.keys(s.setsByExercise).map(id => {
      let group = null, ex = null;
      for (const g of GROUPS_DATA) { const found = g.exercises.find(e => e.id === id); if (found) { group = g; ex = found; break; } }
      if (!ex) return null;
      const validSessions = (s.setsByExercise[id] || []).filter(sn => sn && Array.isArray(sn.sets) && sn.sets.length > 0);
      const flatSets = validSessions.flatMap(session => session.sets);
      if (!flatSets.length) return null;
      const best = flatSets.reduce((a, b) => (b.weight > a.weight ? b : a));
      return { name: ex.name, machine: ex.machine, weightLabel: `${best.weight} ${unitLabel}`, repsSeries: `${best.reps} reps` };
    }).filter(Boolean);

    const lastPrEntry = allPrs.length ? allPrs[allPrs.length - 1] : null;

    const jsDay = new Date().getDay();
    const todayKey = DAY_DEFS[(jsDay + 6) % 7].key;
    const days = DAY_DEFS.map(d => {
      const list = (s.weekPlan[d.key] || []).map(ex => ({
        name: ex.name,
        remove: () => this.removeFromDay(d.key, ex.id),
      }));
      const pickerOpen = s.pickerDay === d.key;
      const already = (s.weekPlan[d.key] || []).map(e => e.id);
      const customFlat = Object.keys(s.customExercises).flatMap(gid =>
        (s.customExercises[gid] || []).map(ex => ({ id: ex.id, name: ex.name, groupName: (GROUPS_DATA.find(g => g.id === gid) || {}).name || '' }))
      );
      const pickerItems = ALL_EXERCISES_FLAT.concat(customFlat).filter(ex => !already.includes(ex.id)).map(ex => ({
        name: ex.name, groupName: ex.groupName,
        add: () => this.addToDay(d.key, ex),
      }));
      return {
        key: d.key, label: d.label, isToday: d.key === todayKey,
        border: d.key === todayKey ? '1.5px solid #B56576' : '1.5px solid transparent',
        list, count: list.length, pickerOpen, pickerItems,
        pickerLabel: pickerOpen ? '– Cerrar' : '+ Añadir ejercicio',
        togglePicker: () => this.setState({ pickerDay: pickerOpen ? null : d.key }),
      };
    });

    const todayPlannedRaw = s.weekPlan[todayKey] || [];
    const todayPlanSteps = [];
    const todayPlanPreview = [];
    todayPlannedRaw.forEach(pex => {
      const priorSessions = (s.setsByExercise[pex.id] || []).filter(sn => sn && Array.isArray(sn.sets) && sn.sets.length > 0);
      let weight = '', reps = 10, seriesCount = 3;
      if (priorSessions.length) {
        const last = priorSessions[0];
        weight = last.sets[0].weight; reps = last.sets[0].reps; seriesCount = last.sets.length;
      }
      const weightLabel = weight !== '' ? `${weight} ${unitLabel}` : 'sin peso previo';
      todayPlanPreview.push({ name: pex.name, label: `${weightLabel} × ${reps} reps × ${seriesCount} series` });
      for (let i = 1; i <= seriesCount; i++) {
        todayPlanSteps.push({ exerciseId: pex.id, exerciseName: pex.name, weight, reps, weightLabel, serieIndex: i, totalSeries: seriesCount });
      }
    });

    const activeStep = s.workoutSteps[s.workoutStepIndex] || null;
    const distinctExIds = [...new Set(s.workoutSteps.map(st => st.exerciseId))];

    const profileParts = [];
    if (s.profile.weight) profileParts.push(`${s.profile.weight} kg`);
    if (s.profile.height) profileParts.push(`${s.profile.height} cm`);
    if (s.profile.age) profileParts.push(`${s.profile.age} años`);

    const shellStyles = this.computeShellStyles(s.viewportMode);
    return {
      shellOuterStyle: shellStyles.outer,
      shellBezelStyle: shellStyles.bezel,
      shellScreenStyle: shellStyles.screen,
      isOnboarding: s.onboardStep !== null,
      isAppMode: s.onboardStep === null,
      isNormalTabs: s.onboardStep === null && !s.workoutActive,
      isWorkoutActive: s.onboardStep === null && s.workoutActive,
      hasTodayPlan: todayPlannedRaw.length > 0,
      todayPlanPreview,
      startWorkout: () => this.startWorkout(todayPlanSteps),
      isWorkoutRunning: s.workoutPhase !== 'complete',
      isPhaseSet: s.workoutPhase === 'set',
      isPhaseChoice: s.workoutPhase === 'choice',
      isPhaseSetOrChoice: s.workoutPhase === 'set' || s.workoutPhase === 'choice',
      isPhaseRestPick: s.workoutPhase === 'restPick',
      isPhaseRestRunning: s.workoutPhase === 'restRunning',
      isPhaseComplete: s.workoutPhase === 'complete',
      workoutExerciseNum: activeStep ? distinctExIds.indexOf(activeStep.exerciseId) + 1 : 0,
      workoutExerciseTotal: distinctExIds.length,
      currentStep: activeStep ? {
        exerciseName: activeStep.exerciseName, serieIndex: activeStep.serieIndex, totalSeries: activeStep.totalSeries,
        weightLabel: activeStep.weightLabel, reps: activeStep.reps,
      } : { exerciseName: '', serieIndex: 0, totalSeries: 0, weightLabel: '', reps: 0 },
      restOptionsView: [0.5, 1, 1.5, 2, 3].map(v => ({
        value: v, label: v === 0.5 ? '30s' : (v % 1 === 0 ? v + ' min' : Math.floor(v) + ':30'),
        bg: !s.restCustomActive && s.restMinutes === v ? '#B56576' : '#FFFFFF', color: !s.restCustomActive && s.restMinutes === v ? '#FFFFFF' : '#2E2A2C',
        pick: () => this.setRestMinutes(v),
      })),
      isRestCustomActive: s.restCustomActive,
      customChipBg: s.restCustomActive ? '#B56576' : '#FFFFFF', customChipColor: s.restCustomActive ? '#FFFFFF' : '#2E2A2C',
      activateCustomRest: () => this.activateCustomRest(),
      customMin: s.customMin, customSec: s.customSec,
      setCustomMin: e => this.setCustomMin(e.target.value),
      setCustomSec: e => this.setCustomSec(e.target.value),
      restDisplay: `${Math.floor(s.restRemaining / 60)}:${String(s.restRemaining % 60).padStart(2, '0')}`,
      completeSet: () => this.completeSet(),
      chooseRest: () => this.chooseRest(),
      chooseContinueStep: () => this.advanceStepOrFinish(),
      startRestCountdown: () => this.startRestCountdown(),
      skipRest: () => this.skipRest(),
      exitWorkout: () => this.exitWorkout(),
      isFormStep: s.onboardStep === 'form',
      isTutorialStep: s.onboardStep === 'tutorial',
      isFinalStep: s.onboardStep === 'final',
      isTut1: s.tutStep === 1, isTut2: s.tutStep === 2, isTut3: s.tutStep === 3, isTut4: s.tutStep === 4, isTut5: s.tutStep === 5,
      tutDots: [1, 2, 3, 4, 5].map(n => ({ color: n === s.tutStep ? '#B56576' : '#E4A3B3', size: n === s.tutStep ? '8px' : '6px' })),
      showBackBtn: s.tutStep > 1,
      nextLabel: s.tutStep < 5 ? 'Siguiente' : 'Continuar',
      nextTutStep: () => this.nextTutStep(),
      prevTutStep: () => this.prevTutStep(),
      skipTutorial: () => this.skipTutorial(),
      replayTutorial: () => this.replayTutorial(),
      finishOnboarding: () => this.finishOnboarding(),
      profile: s.profile,
      formError: s.formError,
      setProfileName: e => this.setState({ profile: Object.assign({}, s.profile, { name: e.target.value }) }),
      setProfileWeight: e => this.setState({ profile: Object.assign({}, s.profile, { weight: e.target.value }) }),
      setProfileHeight: e => this.setState({ profile: Object.assign({}, s.profile, { height: e.target.value }) }),
      setProfileAge: e => this.setState({ profile: Object.assign({}, s.profile, { age: e.target.value }) }),
      setGoalGanar: () => this.setState({ profile: Object.assign({}, s.profile, { goal: 'ganar' }) }),
      setGoalPerder: () => this.setState({ profile: Object.assign({}, s.profile, { goal: 'perder' }) }),
      setGoalMantener: () => this.setState({ profile: Object.assign({}, s.profile, { goal: 'mantener' }) }),
      goalGanarBg: s.profile.goal === 'ganar' ? '#B56576' : 'transparent', goalGanarColor: s.profile.goal === 'ganar' ? '#FFFFFF' : '#2E2A2C',
      goalPerderBg: s.profile.goal === 'perder' ? '#B56576' : 'transparent', goalPerderColor: s.profile.goal === 'perder' ? '#FFFFFF' : '#2E2A2C',
      goalMantenerBg: s.profile.goal === 'mantener' ? '#B56576' : 'transparent', goalMantenerColor: s.profile.goal === 'mantener' ? '#FFFFFF' : '#2E2A2C',
      submitProfileForm: () => this.submitProfileForm(),
      finalGreeting: s.profile.name.trim() ? `¡Listo, ${s.profile.name.trim()}!` : '¡Todo listo!',
      greetName: `Hola, ${s.profile.name.trim() || 'atleta'}`,
      profileSummary: profileParts.length ? profileParts.join(' · ') : 'Completa tus datos en Perfil',
      isHome: s.tab === 'home',
      isCalendar: s.tab === 'calendar',
      isProgress: s.tab === 'progress',
      isProfile: s.tab === 'profile',
      days,
      showGroupGrid: s.tab === 'exercises' && !s.groupId,
      showExerciseList: s.tab === 'exercises' && !!s.groupId && !s.exerciseId,
      showDetail: s.tab === 'exercises' && !!s.exerciseId,
      groups, exercisesForGroup,
      group: groupObj ? { name: groupObj.name, count: combinedExercises.length } : { name: '', count: 0 },
      exercise: exerciseObj ? {
        name: exerciseObj.name, typeLabel: TYPE_LABELS[exerciseObj.type || 'maquina'], heroId: `ex-hero-${exerciseObj.id}`,
        posInicial: (s.exerciseNotes[exerciseObj.id] || {}).posInicial || (s.exerciseNotesSeed[exerciseObj.id] || {}).posInicial || '',
        ejecucion: (s.exerciseNotes[exerciseObj.id] || {}).ejecucion || (s.exerciseNotesSeed[exerciseObj.id] || {}).ejecucion || '',
      } : { name: '', typeLabel: '', heroId: 'ex-hero-none', posInicial: '', ejecucion: '' },
      setPosInicial: e => this.updateExerciseNote(exerciseObj && exerciseObj.id, 'posInicial', e.target.value),
      setEjecucion: e => this.updateExerciseNote(exerciseObj && exerciseObj.id, 'ejecucion', e.target.value),
      heroPointerDown: e => this.heroPointerDown(e),
      heroPointerMove: e => this.heroPointerMove(e),
      heroPointerUp: () => this.heroPointerUp(),
      heroTrackTransform: `translateX(calc(${-(s.heroIndex + 1) * (100 / 3)}% + ${s.heroDragging ? s.heroDragPx : 0}px))`,
      heroTrackTransition: s.heroDragging ? 'none' : 'transform .3s cubic-bezier(.22,1,.36,1)',
      heroDots: [-1, 0, 1].map(i => ({
        size: s.heroIndex === i ? '18px' : '6px',
        color: s.heroIndex === i ? '#B56576' : '#E4A3B3',
        go: () => this.setState({ heroIndex: i }),
      })),
      heroCaption: s.heroIndex === -1 ? 'Posición inicial' : s.heroIndex === 1 ? 'Ejecución' : 'Desliza ← ejecución · posición inicial →',
      isAddFormOpenHere, isAddFormClosedHere: !isAddFormOpenHere, addForm: s.addForm,
      openAddForm: () => groupObj && this.openAddForm(groupObj.id),
      closeAddForm: () => this.closeAddForm(),
      setAddName: e => this.setAddFormField('name', e.target.value),
      setAddMachine: e => this.setAddFormField('machine', e.target.value),
      setAddTypeMaquina: () => this.setAddFormField('type', 'maquina'),
      setAddTypeLibre: () => this.setAddFormField('type', 'libre'),
      setAddTypeCorporal: () => this.setAddFormField('type', 'corporal'),
      addTypeMaquinaBg: s.addForm.type === 'maquina' ? '#B56576' : 'transparent', addTypeMaquinaColor: s.addForm.type === 'maquina' ? '#FFFFFF' : '#2E2A2C',
      addTypeLibreBg: s.addForm.type === 'libre' ? '#B56576' : 'transparent', addTypeLibreColor: s.addForm.type === 'libre' ? '#FFFFFF' : '#2E2A2C',
      addTypeCorporalBg: s.addForm.type === 'corporal' ? '#B56576' : 'transparent', addTypeCorporalColor: s.addForm.type === 'corporal' ? '#FFFFFF' : '#2E2A2C',
      saveCustomExercise: () => groupObj && this.saveCustomExercise(groupObj.id),
      backToGroups: () => this.setState({ groupId: null, exerciseId: null, navSeq: s.navSeq + 1 }),
      backToList: () => this.setState({ exerciseId: null, navSeq: s.navSeq + 1 }),
      form: s.form,
      setWeight: e => this.setState({ form: Object.assign({}, s.form, { weight: e.target.value }) }),
      setReps: e => this.setState({ form: Object.assign({}, s.form, { reps: e.target.value }) }),
      setSeries: e => this.setState({ form: Object.assign({}, s.form, { series: e.target.value }) }),
      isLinearMode: s.logMode === 'linear', isMultiMode: s.logMode === 'multi',
      setLogModeLinear: () => this.setState({ logMode: 'linear' }),
      setLogModeMulti: () => this.setState({ logMode: 'multi' }),
      modeLinearBg: s.logMode === 'linear' ? '#B56576' : 'transparent', modeLinearColor: s.logMode === 'linear' ? '#FFFFFF' : '#2E2A2C',
      modeMultiBg: s.logMode === 'multi' ? '#B56576' : 'transparent', modeMultiColor: s.logMode === 'multi' ? '#FFFFFF' : '#2E2A2C',
      multiRowsView: s.multiRows.map((row, i) => ({
        n: i + 1, weight: row.weight, reps: row.reps,
        setWeight: e => this.updateMultiRow(i, 'weight', e.target.value),
        setReps: e => this.updateMultiRow(i, 'reps', e.target.value),
        remove: () => this.removeMultiRow(i),
      })),
      addMultiRow: () => this.addMultiRow(),
      addSet: () => {
        if (!exerciseObj) return;
        const w = parseFloat(s.form.weight) || 0, r = parseInt(s.form.reps) || 0, se = parseInt(s.form.series) || 0;
        if (w <= 0 || r <= 0 || se <= 0) return;
        const prevBest = sessions.length ? Math.max(...sessions.flatMap(sn => sn.sets.map(x => x.weight))) : 0;
        const entry = { date: 'Hoy', sets: Array.from({ length: se }, () => ({ weight: w, reps: r })) };
        const nextSets = Object.assign({}, s.setsByExercise, { [exerciseObj.id]: [entry, ...sessions] });
        const isPr = w > prevBest;
        this.setState({ setsByExercise: nextSets, justPr: isPr });
        this.persist(nextSets);
        if (isPr) setTimeout(() => this.setState({ justPr: false }), 2600);
      },
      saveMultiSession: () => {
        if (!exerciseObj) return;
        const validRows = s.multiRows.filter(r => (parseFloat(r.weight) || 0) > 0 && (parseInt(r.reps) || 0) > 0);
        if (!validRows.length) return;
        const newSets = validRows.map(r => ({ weight: parseFloat(r.weight) || 0, reps: parseInt(r.reps) || 0 }));
        const prevBest = sessions.length ? Math.max(...sessions.flatMap(sn => sn.sets.map(x => x.weight))) : 0;
        const entry = { date: 'Hoy', sets: newSets };
        const nextSets = Object.assign({}, s.setsByExercise, { [exerciseObj.id]: [entry, ...sessions] });
        const isPr = newSets.some(x => x.weight > prevBest);
        this.setState({ setsByExercise: nextSets, justPr: isPr, multiRows: defaultMultiRows() });
        this.persist(nextSets);
        if (isPr) setTimeout(() => this.setState({ justPr: false }), 2600);
      },
      justPr: s.justPr,
      hasHistory: sessions.length > 0,
      historyRows, bars,
      hasPrs: allPrs.length > 0, hasPrsInverse: allPrs.length === 0,
      prList: allPrs,
      lastPr: lastPrEntry ? { label: lastPrEntry.name, detail: `${lastPrEntry.weightLabel} · ${lastPrEntry.repsSeries}` } : false,
      weekCount: 4, prCount: allPrs.length,
      unitKgBg: s.unit === 'kg' ? '#B56576' : 'transparent', unitKgColor: s.unit === 'kg' ? '#FFFFFF' : '#2E2A2C',
      unitLbBg: s.unit === 'lb' ? '#B56576' : 'transparent', unitLbColor: s.unit === 'lb' ? '#FFFFFF' : '#2E2A2C',
      setUnitKg: () => this.setState({ unit: 'kg' }), setUnitLb: () => this.setState({ unit: 'lb' }),
      fileInputRef: this.fileInputRef,
      exportProgress: () => this.exportProgress(),
      triggerImport: () => this.triggerImport(),
      handleImportFile: e => this.handleImportFile(e),
      transferMsg: s.transferMsg,
      tabColorHome: s.tab === 'home' ? '#B56576' : '#355070',
      tabColorExercises: s.tab === 'exercises' ? '#B56576' : '#355070',
      tabColorCalendar: s.tab === 'calendar' ? '#B56576' : '#355070',
      tabColorProgress: s.tab === 'progress' ? '#B56576' : '#355070',
      tabColorProfile: s.tab === 'profile' ? '#B56576' : '#355070',
      goHome: () => this.setState({ tab: 'home', navSeq: s.navSeq + 1 }),
      goExercises: () => this.setState({ tab: 'exercises', navSeq: s.navSeq + 1 }),
      goCalendar: () => this.setState({ tab: 'calendar', navSeq: s.navSeq + 1 }),
      goProgress: () => this.setState({ tab: 'progress', navSeq: s.navSeq + 1 }),
      goProfile: () => this.setState({ tab: 'profile', navSeq: s.navSeq + 1 }),
    };
  }
}

</script>
</body>
</html>
