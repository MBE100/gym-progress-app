<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#355070">
<link rel="icon" href="./icons/icon-192.png">
<link rel="apple-touch-icon" href="./icons/icon-192.png">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet data-dc-atomics="">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caprasimo&amp;family=Figtree:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<script src="./image-slot.js"></script>
<style>
body{margin:0}
a{color:#B56576}
a:hover{color:#355070}
@keyframes fadeSlideUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes growUp{from{transform:scaleY(0)}to{transform:scaleY(1)}}
@keyframes screenIn{from{opacity:0;transform:translateX(8px)}to{opacity:1;transform:translateX(0)}}
@keyframes popIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
@keyframes prToast{0%{opacity:0;transform:translateY(-6px)}12%{opacity:1;transform:translateY(0)}88%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-6px)}}
</style>
</helmet>

<div style="{{ shellOuterStyle }}">
  <div style="{{ shellBezelStyle }}">
    <div style="{{ shellScreenStyle }}">

      <div style="display:flex;justify-content:space-between;padding:16px 24px 4px;font-size:12px;font-weight:600;color:#355070;flex:none">
        <span>9:41</span>
      </div>

      <div style="flex:1;overflow-y:auto;animation:screenIn .35s cubic-bezier(.2,.8,.3,1) both">

        <!-- ONBOARDING: PROFILE FORM -->
        <sc-if value="{{ isFormStep }}" hint-placeholder-val="{{ false }}">
          <div style="padding:32px 24px 28px;display:flex;flex-direction:column;gap:22px;min-height:520px;box-sizing:border-box">
            <div style="animation:fadeSlideUp .45s ease both">
              <div style="font-size:11px;color:#355070;opacity:.7;letter-spacing:.08em;text-transform:uppercase">Bienvenido</div>
              <div style="font-family:'Caprasimo',system-ui;font-size:26px;color:#2E2A2C;margin-top:4px">Cuéntanos de ti</div>
              <div style="font-size:12.5px;color:#2E2A2C;opacity:.6;margin-top:6px;line-height:1.5">Nos ayuda a personalizar tu progreso en el gym.</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:14px;animation:fadeSlideUp .45s .05s ease both">
              <div><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Nombre</label><input value="{{ profile.name }}" onChange="{{ setProfileName }}" placeholder="¿Cómo te llamas?" style="width:100%;box-sizing:border-box;padding:10px 14px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13.5px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
              <div style="display:flex;gap:10px">
                <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Peso (kg)</label><input value="{{ profile.weight }}" onChange="{{ setProfileWeight }}" placeholder="70" style="width:100%;box-sizing:border-box;text-align:center;padding:10px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13.5px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
                <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Estatura (cm)</label><input value="{{ profile.height }}" onChange="{{ setProfileHeight }}" placeholder="170" style="width:100%;box-sizing:border-box;text-align:center;padding:10px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13.5px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
                <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Edad</label><input value="{{ profile.age }}" onChange="{{ setProfileAge }}" placeholder="25" style="width:100%;box-sizing:border-box;text-align:center;padding:10px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13.5px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
              </div>
              <div>
                <label style="font-size:11px;color:#355070;display:block;margin-bottom:6px">Objetivo</label>
                <div style="display:flex;border-radius:999px;background:#FFFFFF;padding:4px;border:1px solid #E4A3B3">
                  <div onClick="{{ setGoalGanar }}" style="flex:1;text-align:center;padding:8px 4px;border-radius:999px;font-size:11.5px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ goalGanarBg }};color:{{ goalGanarColor }}">Ganar músculo</div>
                  <div onClick="{{ setGoalPerder }}" style="flex:1;text-align:center;padding:8px 4px;border-radius:999px;font-size:11.5px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ goalPerderBg }};color:{{ goalPerderColor }}">Perder grasa</div>
                  <div onClick="{{ setGoalMantener }}" style="flex:1;text-align:center;padding:8px 4px;border-radius:999px;font-size:11.5px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ goalMantenerBg }};color:{{ goalMantenerColor }}">Mantenerme</div>
                </div>
              </div>
            </div>
            <sc-if value="{{ formError }}" hint-placeholder-val="{{ false }}">
              <div style="font-size:12px;color:#B56576;animation:popIn .2s ease both">{{ formError }}</div>
            </sc-if>
            <button onClick="{{ submitProfileForm }}" style="width:100%;padding:13px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:14px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Continuar</button>
          </div>
        </sc-if>

        <!-- ONBOARDING: TUTORIAL -->
        <sc-if value="{{ isTutorialStep }}" hint-placeholder-val="{{ false }}">
          <div style="padding:20px 24px 28px;display:flex;flex-direction:column;min-height:560px;box-sizing:border-box">
            <div style="display:flex;justify-content:flex-end">
              <div onClick="{{ skipTutorial }}" style="cursor:pointer;font-size:12px;color:#355070;opacity:.55;transition:opacity .15s ease" style-hover="opacity:.9">Omitir</div>
            </div>
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding:0 8px">
              <sc-if value="{{ isTut1 }}" hint-placeholder-val="{{ true }}">
                <div style="width:64px;height:64px;border-radius:20px;background:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:26px;color:#B56576;animation:popIn .4s ease both">⌂</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">Inicio</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;line-height:1.6;max-width:250px;animation:fadeSlideUp .4s .1s ease both">Tu resumen semanal, grupos musculares y tu último récord, todo en un vistazo.</div>
              </sc-if>
              <sc-if value="{{ isTut2 }}" hint-placeholder-val="{{ false }}">
                <div style="width:64px;height:64px;border-radius:20px;background:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:26px;color:#B56576;animation:popIn .4s ease both">▤</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">Ejercicios</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;line-height:1.6;max-width:250px;animation:fadeSlideUp .4s .1s ease both">Explora ejercicios por grupo muscular y registra cuánto peso, reps y series haces en cada uno.</div>
              </sc-if>
              <sc-if value="{{ isTut3 }}" hint-placeholder-val="{{ false }}">
                <div style="width:64px;height:64px;border-radius:20px;background:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:26px;color:#B56576;animation:popIn .4s ease both">▦</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">Calendario</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;line-height:1.6;max-width:250px;animation:fadeSlideUp .4s .1s ease both">Organiza qué ejercicios harás cada día de tu semana.</div>
              </sc-if>
              <sc-if value="{{ isTut4 }}" hint-placeholder-val="{{ false }}">
                <div style="width:64px;height:64px;border-radius:20px;background:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:26px;color:#B56576;animation:popIn .4s ease both">◱</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">Progreso</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;line-height:1.6;max-width:250px;animation:fadeSlideUp .4s .1s ease both">Mira tus récords personales en cada ejercicio a medida que avanzas.</div>
              </sc-if>
              <sc-if value="{{ isTut5 }}" hint-placeholder-val="{{ false }}">
                <div style="width:64px;height:64px;border-radius:20px;background:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:26px;color:#B56576;animation:popIn .4s ease both">◯</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">Perfil</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;line-height:1.6;max-width:250px;animation:fadeSlideUp .4s .1s ease both">Ajusta tus datos y lleva tu progreso a otro dispositivo cuando quieras.</div>
              </sc-if>
            </div>
            <div style="display:flex;justify-content:center;gap:6px;margin-bottom:20px">
              <sc-for list="{{ tutDots }}" as="dot" hint-placeholder-count="5">
                <div style="width:{{ dot.size }};height:{{ dot.size }};border-radius:999px;background:{{ dot.color }};transition:all .2s ease"></div>
              </sc-for>
            </div>
            <div style="display:flex;gap:10px">
              <sc-if value="{{ showBackBtn }}" hint-placeholder-val="{{ false }}">
                <button onClick="{{ prevTutStep }}" style="flex:1;padding:12px;border-radius:999px;border:1.5px solid #355070;background:transparent;color:#355070;font-family:'Figtree';font-weight:600;font-size:13.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#F1FAEE" style-active="transform:scale(.97)">Atrás</button>
              </sc-if>
              <button onClick="{{ nextTutStep }}" style="flex:2;padding:12px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:13.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">{{ nextLabel }}</button>
            </div>
          </div>
        </sc-if>

        <!-- ONBOARDING: FINAL -->
        <sc-if value="{{ isFinalStep }}" hint-placeholder-val="{{ false }}">
          <div style="padding:40px 28px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:18px;min-height:560px;box-sizing:border-box">
            <div style="font-size:38px;animation:popIn .5s ease both">💛</div>
            <div style="font-family:'Caprasimo',system-ui;font-size:23px;color:#2E2A2C;animation:fadeSlideUp .45s .05s ease both">{{ finalGreeting }}</div>
            <div style="font-size:13.5px;color:#2E2A2C;opacity:.75;line-height:1.6;max-width:250px;animation:fadeSlideUp .45s .1s ease both">Cada serie que registres te acerca a la mejor versión de ti.<br>"<b>La constancia</b>, no la perfección, es lo que <b>transforma</b>"</div>
            <div style="width:60px;height:1px;background:#E4A3B3;margin:2px 0"></div>
            <div style="font-size:12.5px;color:#355070;animation:fadeSlideUp .45s .15s ease both">Gracias GymBro</div>
            <button onClick="{{ finishOnboarding }}" style="width:100%;margin-top:8px;padding:13px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:14px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Empezar a entrenar</button>
          </div>
        </sc-if>

        <!-- WORKOUT RUNNER -->
        <sc-if value="{{ isWorkoutActive }}" hint-placeholder-val="{{ false }}">
          <div style="padding:20px 24px 28px;display:flex;flex-direction:column;min-height:560px;box-sizing:border-box;gap:18px">
            <sc-if value="{{ isWorkoutRunning }}" hint-placeholder-val="{{ true }}">
              <div style="display:flex;justify-content:space-between;align-items:center">
                <div style="font-size:11px;color:#355070;opacity:.7">Ejercicio {{ workoutExerciseNum }} de {{ workoutExerciseTotal }}</div>
                <div onClick="{{ exitWorkout }}" style="cursor:pointer;font-size:12px;color:#355070;opacity:.55;transition:opacity .15s ease" style-hover="opacity:.9">Salir</div>
              </div>
              <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:8px">
                <div style="font-family:'Caprasimo',system-ui;font-size:22px;color:#2E2A2C;animation:fadeSlideUp .3s ease both">{{ currentStep.exerciseName }}</div>
                <div style="font-size:12.5px;color:#355070">Serie {{ currentStep.serieIndex }} de {{ currentStep.totalSeries }}</div>
                <sc-if value="{{ isPhaseSetOrChoice }}" hint-placeholder-val="{{ true }}">
                  <div style="display:flex;gap:24px;margin-top:12px;animation:popIn .35s ease both">
                    <div><div style="font-family:'Caprasimo',system-ui;font-size:28px;color:#B56576">{{ currentStep.weightLabel }}</div><div style="font-size:10px;color:#2E2A2C;opacity:.55;text-transform:uppercase;letter-spacing:.06em">Carga</div></div>
                    <div><div style="font-family:'Caprasimo',system-ui;font-size:28px;color:#355070">{{ currentStep.reps }}</div><div style="font-size:10px;color:#2E2A2C;opacity:.55;text-transform:uppercase;letter-spacing:.06em">Reps</div></div>
                  </div>
                </sc-if>
              </div>
              <sc-if value="{{ isPhaseSet }}" hint-placeholder-val="{{ true }}">
                <button onClick="{{ completeSet }}" style="width:100%;padding:15px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:700;font-size:14.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">✓ Completé esta serie</button>
              </sc-if>
              <sc-if value="{{ isPhaseChoice }}" hint-placeholder-val="{{ false }}">
                <div style="display:flex;flex-direction:column;gap:10px;animation:fadeSlideUp .3s ease both">
                  <div style="font-size:12.5px;color:#2E2A2C;opacity:.6;text-align:center">¿Qué sigue?</div>
                  <div style="display:flex;gap:10px">
                    <button onClick="{{ chooseRest }}" style="flex:1;padding:13px;border-radius:999px;border:1.5px solid #355070;background:transparent;color:#355070;font-family:'Figtree';font-weight:600;font-size:13.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#F1FAEE" style-active="transform:scale(.97)">Descansar</button>
                    <button onClick="{{ chooseContinueStep }}" style="flex:1;padding:13px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:13.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Continuar</button>
                  </div>
                </div>
              </sc-if>
              <sc-if value="{{ isPhaseRestPick }}" hint-placeholder-val="{{ false }}">
                <div style="display:flex;flex-direction:column;gap:14px;animation:fadeSlideUp .3s ease both">
                  <div style="font-size:13px;font-weight:600;color:#2E2A2C;text-align:center">¿Cuánto vas a descansar?</div>
                  <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center">
                    <sc-for list="{{ restOptionsView }}" as="opt" hint-placeholder-count="5">
                      <div onClick="{{ opt.pick }}" style="cursor:pointer;padding:9px 16px;border-radius:999px;border:1.5px solid #E4A3B3;font-size:13px;transition:background .15s ease,color .15s ease;background:{{ opt.bg }};color:{{ opt.color }}">{{ opt.label }}</div>
                    </sc-for>
                    <div onClick="{{ activateCustomRest }}" style="cursor:pointer;padding:9px 16px;border-radius:999px;border:1.5px solid #E4A3B3;font-size:13px;transition:background .15s ease,color .15s ease;background:{{ customChipBg }};color:{{ customChipColor }}">Personalizado</div>
                  </div>
                  <sc-if value="{{ isRestCustomActive }}" hint-placeholder-val="{{ false }}">
                    <div style="display:flex;align-items:center;justify-content:center;gap:8px;animation:popIn .25s ease both">
                      <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
                        <input value="{{ customMin }}" onChange="{{ setCustomMin }}" placeholder="0" style="width:56px;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:14px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                        <div style="font-size:10px;color:#355070;opacity:.7">min</div>
                      </div>
                      <div style="font-size:18px;color:#2E2A2C;opacity:.4;margin-top:-16px">:</div>
                      <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
                        <input value="{{ customSec }}" onChange="{{ setCustomSec }}" placeholder="30" style="width:56px;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:14px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                        <div style="font-size:10px;color:#355070;opacity:.7">seg</div>
                      </div>
                    </div>
                  </sc-if>
                  <button onClick="{{ startRestCountdown }}" style="width:100%;padding:13px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:13.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Iniciar descanso</button>
                </div>
              </sc-if>
              <sc-if value="{{ isPhaseRestRunning }}" hint-placeholder-val="{{ false }}">
                <div style="display:flex;flex-direction:column;align-items:center;gap:16px;animation:fadeSlideUp .3s ease both">
                  <div style="font-size:11px;color:#355070;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Descansando</div>
                  <div style="font-family:'Caprasimo',system-ui;font-size:50px;color:#B56576">{{ restDisplay }}</div>
                  <div onClick="{{ skipRest }}" style="cursor:pointer;font-size:12.5px;color:#355070;text-decoration:underline;opacity:.75;transition:opacity .15s ease" style-hover="opacity:1">Saltar descanso</div>
                </div>
              </sc-if>
            </sc-if>
            <sc-if value="{{ isPhaseComplete }}" hint-placeholder-val="{{ false }}">
              <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px">
                <div style="font-size:36px;animation:popIn .4s ease both">💪</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:22px;color:#2E2A2C;animation:fadeSlideUp .4s .05s ease both">¡Entrenamiento completado!</div>
                <div style="font-size:13px;color:#2E2A2C;opacity:.7;max-width:240px;line-height:1.5;animation:fadeSlideUp .4s .1s ease both">Registramos todas tus series de hoy. Sigue así.</div>
                <button onClick="{{ exitWorkout }}" style="width:100%;padding:13px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:14px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Volver a inicio</button>
              </div>
            </sc-if>
          </div>
        </sc-if>

        <sc-if value="{{ isNormalTabs }}" hint-placeholder-val="{{ true }}">

        <!-- HOME -->
        <sc-if value="{{ isHome }}" hint-placeholder-val="{{ true }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:20px">
            <div style="animation:fadeSlideUp .45s ease both">
              <div style="font-size:13px;color:#355070;opacity:.75">{{ greetName }}</div>
              <div style="font-family:'Caprasimo',system-ui;font-size:28px;color:#2E2A2C;margin-top:2px">Tu progreso</div>
            </div>
            <sc-if value="{{ hasTodayPlan }}" hint-placeholder-val="{{ false }}">
              <div style="background:#355070;border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:12px;animation:fadeSlideUp .45s .02s ease both">
                <div>
                  <div style="font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#F1FAEE;opacity:.8">Hoy toca</div>
                  <div style="font-family:'Caprasimo',system-ui;font-size:18px;color:#FFFFFF;margin-top:2px">Entrenamiento del día</div>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px">
                  <sc-for list="{{ todayPlanPreview }}" as="tp" hint-placeholder-count="3">
                    <div style="font-size:12px;color:#F1FAEE;opacity:.9">{{ tp.name }} — {{ tp.label }}</div>
                  </sc-for>
                </div>
                <button onClick="{{ startWorkout }}" style="width:100%;padding:11px;border-radius:999px;border:none;background:#FFFFFF;color:#355070;font-family:'Figtree';font-weight:700;font-size:13px;cursor:pointer;transition:transform .12s ease" style-active="transform:scale(.97)">Iniciar entrenamiento</button>
              </div>
            </sc-if>
            <div style="display:flex;gap:12px;animation:fadeSlideUp .45s .05s ease both">
              <div style="flex:1;background:#FFFFFF;border-radius:20px;padding:16px;transition:transform .2s ease" style-hover="transform:translateY(-3px)">
                <div style="font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#B56576">Semana</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:26px;color:#2E2A2C;margin-top:4px">{{ weekCount }}</div>
                <div style="font-size:12px;color:#2E2A2C;opacity:.65">entrenamientos</div>
              </div>
              <div style="flex:1;background:#F1FAEE;border-radius:20px;padding:16px;transition:transform .2s ease" style-hover="transform:translateY(-3px)">
                <div style="font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#355070">Récords</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:26px;color:#2E2A2C;margin-top:4px">{{ prCount }}</div>
                <div style="font-size:12px;color:#2E2A2C;opacity:.65">nuevos PR</div>
              </div>
            </div>
            <div style="animation:fadeSlideUp .45s .1s ease both">
              <div style="font-size:14px;font-weight:600;color:#2E2A2C;margin-bottom:10px">Grupos musculares</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <sc-for list="{{ groups }}" as="g" hint-placeholder-count="8">
                  <div onClick="{{ g.open }}" style="cursor:pointer;background:#FFFFFF;border-radius:18px;padding:12px;display:flex;flex-direction:column;gap:8px;animation:fadeSlideUp .4s both;transition:transform .18s ease,box-shadow .18s ease" style-hover="transform:translateY(-3px);box-shadow:0 10px 22px rgba(46,42,44,.1)" style-active="transform:scale(.97)">
                    <div style="width:100%;aspect-ratio:4/3;border-radius:12px;overflow:hidden">
                      <image-slot id="{{ g.imgId }}" shape="rect" placeholder="Foto del grupo muscular" style="width:100%;height:100%"></image-slot>
                    </div>
                    <div style="font-family:'Caprasimo',system-ui;font-size:14px;color:#2E2A2C">{{ g.name }}</div>
                    <div style="font-size:11px;color:#2E2A2C;opacity:.55">{{ g.count }} ejercicios</div>
                  </div>
                </sc-for>
              </div>
            </div>
            <sc-if value="{{ lastPr }}" hint-placeholder-val="{{ false }}">
              <div style="background:#B56576;border-radius:20px;padding:16px;animation:fadeSlideUp .45s .15s ease both">
                <div style="font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#F6E7E2;opacity:.85">Nuevo récord</div>
                <div style="font-family:'Caprasimo',system-ui;font-size:17px;color:#FFFFFF;margin-top:4px">{{ lastPr.label }}</div>
                <div style="font-size:12px;color:#F6E7E2;opacity:.9;margin-top:2px">{{ lastPr.detail }}</div>
              </div>
            </sc-if>
          </div>
        </sc-if>

        <!-- EXERCISES: GROUP GRID -->
        <sc-if value="{{ showGroupGrid }}" hint-placeholder-val="{{ false }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:16px">
            <div style="font-family:'Caprasimo',system-ui;font-size:24px;color:#2E2A2C;animation:fadeSlideUp .4s both">Ejercicios</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <sc-for list="{{ groups }}" as="g" hint-placeholder-count="8">
                <div onClick="{{ g.open }}" style="cursor:pointer;background:#FFFFFF;border-radius:18px;padding:12px;display:flex;flex-direction:column;gap:8px;animation:fadeSlideUp .4s both;transition:transform .18s ease" style-hover="transform:translateY(-3px)" style-active="transform:scale(.97)">
                  <div style="width:100%;aspect-ratio:4/3;border-radius:12px;overflow:hidden">
                    <image-slot id="{{ g.imgId }}" shape="rect" placeholder="Foto del grupo muscular" style="width:100%;height:100%"></image-slot>
                  </div>
                  <div style="font-family:'Caprasimo',system-ui;font-size:14px;color:#2E2A2C">{{ g.name }}</div>
                  <div style="font-size:11px;color:#2E2A2C;opacity:.55">{{ g.count }} ejercicios</div>
                </div>
              </sc-for>
            </div>
          </div>
        </sc-if>

        <!-- EXERCISES: LIST FOR GROUP -->
        <sc-if value="{{ showExerciseList }}" hint-placeholder-val="{{ false }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:12px">
            <div style="display:flex;align-items:center;gap:10px">
              <div onClick="{{ backToGroups }}" style="cursor:pointer;font-size:18px;color:#355070;transition:transform .15s ease" style-active="transform:scale(.85)">←</div>
              <div style="font-family:'Caprasimo',system-ui;font-size:22px;color:#2E2A2C">{{ group.name }}</div>
            </div>
            <div style="display:inline-flex;align-self:flex-start;font-size:11px;padding:4px 12px;border-radius:999px;border:1px solid #355070;color:#355070">{{ group.count }} ejercicios · máquina y libre</div>
            <sc-for list="{{ exercisesForGroup }}" as="ex" hint-placeholder-count="4">
              <div style="cursor:pointer;background:#FFFFFF;border-radius:18px;padding:10px;display:flex;align-items:center;gap:12px;animation:fadeSlideUp .35s both;transition:transform .16s ease" style-hover="transform:translateX(2px)">
                <div style="width:52px;height:52px;flex:none;border-radius:12px;overflow:hidden">
                  <image-slot id="{{ ex.thumbId }}" shape="rect" placeholder="Foto" style="width:100%;height:100%"></image-slot>
                </div>
                <div onClick="{{ ex.open }}" style="flex:1">
                  <div style="font-family:'Caprasimo',system-ui;font-size:15px;color:#2E2A2C">{{ ex.name }}</div>
                  <div style="font-size:11px;color:#2E2A2C;opacity:.55">{{ ex.machine }} · {{ ex.typeLabel }}</div>
                </div>
                <div onClick="{{ ex.toggleFav }}" style="cursor:pointer;padding:4px;flex:none;transition:transform .15s ease" style-active="transform:scale(.8)">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="{{ ex.favFill }}" stroke="#B56576" stroke-width="1.8"><path d="M12 2.5l2.9 6.06 6.6.85-4.8 4.6 1.2 6.66L12 17.9l-5.9 3.16 1.2-6.65-4.8-4.6 6.6-.86L12 2.5z"></path></svg>
                </div>
                <sc-if value="{{ ex.isCustom }}" hint-placeholder-val="{{ false }}">
                  <div onClick="{{ ex.remove }}" style="cursor:pointer;color:#B56576;font-size:15px;padding:2px 6px;transition:transform .12s ease" style-active="transform:scale(.8)">×</div>
                </sc-if>
                <div onClick="{{ ex.open }}" style="color:#B56576;font-size:16px">›</div>
              </div>
            </sc-for>

            <sc-if value="{{ isAddFormOpenHere }}" hint-placeholder-val="{{ false }}">
              <div style="background:#FFFFFF;border-radius:18px;padding:14px;display:flex;flex-direction:column;gap:10px;animation:fadeSlideUp .3s ease both">
                <div style="font-size:13px;font-weight:600;color:#2E2A2C">Añadir ejercicio</div>
                <input value="{{ addForm.name }}" onChange="{{ setAddName }}" placeholder="Nombre del ejercicio" style="width:100%;box-sizing:border-box;padding:9px 14px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                <input value="{{ addForm.machine }}" onChange="{{ setAddMachine }}" placeholder="Equipo (opcional, ej. Mancuernas)" style="width:100%;box-sizing:border-box;padding:9px 14px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                <div style="display:flex;border-radius:999px;background:#F6E7E2;padding:4px">
                  <div onClick="{{ setAddTypeMaquina }}" style="flex:1;text-align:center;padding:7px 4px;border-radius:999px;font-size:11px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ addTypeMaquinaBg }};color:{{ addTypeMaquinaColor }}">Máquina</div>
                  <div onClick="{{ setAddTypeLibre }}" style="flex:1;text-align:center;padding:7px 4px;border-radius:999px;font-size:11px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ addTypeLibreBg }};color:{{ addTypeLibreColor }}">Peso libre</div>
                  <div onClick="{{ setAddTypeCorporal }}" style="flex:1;text-align:center;padding:7px 4px;border-radius:999px;font-size:11px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ addTypeCorporalBg }};color:{{ addTypeCorporalColor }}">Sin equipo</div>
                </div>
                <div style="display:flex;gap:8px">
                  <button onClick="{{ closeAddForm }}" style="flex:1;padding:10px;border-radius:999px;border:1.5px solid #355070;background:transparent;color:#355070;font-family:'Figtree';font-weight:600;font-size:12.5px;cursor:pointer">Cancelar</button>
                  <button onClick="{{ saveCustomExercise }}" style="flex:1;padding:10px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:12.5px;cursor:pointer;transition:background .15s ease" style-hover="background:#9c4f60">Guardar</button>
                </div>
              </div>
            </sc-if>
            <sc-if value="{{ isAddFormClosedHere }}" hint-placeholder-val="{{ true }}">
              <div onClick="{{ openAddForm }}" style="cursor:pointer;background:transparent;border:1.5px dashed #B56576;border-radius:18px;padding:12px;text-align:center;font-size:12.5px;color:#B56576;font-weight:600;transition:background .15s ease" style-hover="background:#FFFFFF">+ Añadir ejercicio</div>
            </sc-if>
          </div>
        </sc-if>

        <!-- EXERCISES: DETAIL + LOG -->
        <sc-if value="{{ showDetail }}" hint-placeholder-val="{{ false }}">
          <div style="padding-bottom:28px;display:flex;flex-direction:column;gap:16px;position:relative">
            <div style="display:flex;align-items:center;gap:10px;padding:8px 24px 0">
              <div onClick="{{ backToList }}" style="cursor:pointer;font-size:18px;color:#355070;transition:transform .15s ease" style-active="transform:scale(.85)">←</div>
              <div style="font-family:'Caprasimo',system-ui;font-size:19px;color:#2E2A2C">{{ exercise.name }}</div>
            </div>
            <div style="margin:0 24px;display:flex;flex-direction:column;gap:8px;animation:popIn .35s ease both">
              <div style="position:relative;aspect-ratio:4/3;border-radius:20px;overflow:hidden;background:#FFFFFF;touch-action:pan-y;user-select:none" onPointerDown="{{ heroPointerDown }}" onPointerMove="{{ heroPointerMove }}" onPointerUp="{{ heroPointerUp }}" onPointerCancel="{{ heroPointerUp }}" onPointerLeave="{{ heroPointerUp }}">
                <div style="display:flex;width:300%;height:100%;transform:{{ heroTrackTransform }};transition:{{ heroTrackTransition }}">
                  <div style="width:33.3333%;flex:none;height:100%;padding:16px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px;background:#F1FAEE">
                    <div style="font-size:12px;font-weight:600;color:#355070">Posición inicial</div>
                    <textarea value="{{ exercise.posInicial }}" onChange="{{ setPosInicial }}" placeholder="Describe la posición inicial" style="flex:1;width:100%;box-sizing:border-box;resize:none;border:none;background:transparent;font-family:'Figtree';font-size:12.5px;color:#2E2A2C;line-height:1.5"></textarea>
                  </div>
                  <div style="width:33.3333%;flex:none;height:100%">
                    <image-slot id="{{ exercise.heroId }}" shape="rect" fit="contain" placeholder="Foto del ejercicio o la máquina" style="width:100%;height:100%"></image-slot>
                  </div>
                  <div style="width:33.3333%;flex:none;height:100%;padding:16px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px;background:#F1FAEE">
                    <div style="font-size:12px;font-weight:600;color:#355070">Ejecución</div>
                    <textarea value="{{ exercise.ejecucion }}" onChange="{{ setEjecucion }}" placeholder="Describe la ejecución del movimiento" style="flex:1;width:100%;box-sizing:border-box;resize:none;border:none;background:transparent;font-family:'Figtree';font-size:12.5px;color:#2E2A2C;line-height:1.5"></textarea>
                  </div>
                </div>
              </div>
              <div style="display:flex;align-items:center;justify-content:center;gap:6px">
                <sc-for list="{{ heroDots }}" as="dot" hint-placeholder-count="3">
                  <div onClick="{{ dot.go }}" style="width:{{ dot.size }};height:6px;border-radius:999px;background:{{ dot.color }};cursor:pointer;transition:all .2s ease"></div>
                </sc-for>
              </div>
              <div style="text-align:center;font-size:10.5px;color:#2E2A2C;opacity:.5">{{ heroCaption }}</div>
            </div>
            <div style="padding:0 24px;display:flex;flex-direction:column;gap:16px">
              <div style="display:flex;gap:8px">
                <div style="font-size:11px;padding:4px 12px;border-radius:999px;background:#E4A3B3;color:#2E2A2C">{{ group.name }}</div>
                <div style="font-size:11px;padding:4px 12px;border-radius:999px;background:#F1FAEE;color:#355070">{{ exercise.typeLabel }}</div>
              </div>
              <div>
                <div style="font-size:14px;font-weight:600;color:#2E2A2C;margin-bottom:10px">Registrar serie</div>
                <div style="display:inline-flex;border-radius:999px;background:#F6E7E2;padding:4px;margin-bottom:12px">
                  <div onClick="{{ setLogModeLinear }}" style="padding:7px 14px;border-radius:999px;font-size:12px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ modeLinearBg }};color:{{ modeLinearColor }}">Simple</div>
                  <div onClick="{{ setLogModeMulti }}" style="padding:7px 14px;border-radius:999px;font-size:12px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ modeMultiBg }};color:{{ modeMultiColor }}">Por serie</div>
                </div>
                <sc-if value="{{ isLinearMode }}" hint-placeholder-val="{{ true }}">
                  <div style="display:flex;gap:8px">
                    <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Carga (kg)</label><input value="{{ form.weight }}" onChange="{{ setWeight }}" style="width:100%;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
                    <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Reps</label><input value="{{ form.reps }}" onChange="{{ setReps }}" style="width:100%;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
                    <div style="flex:1"><label style="font-size:11px;color:#355070;display:block;margin-bottom:4px">Series</label><input value="{{ form.series }}" onChange="{{ setSeries }}" style="width:100%;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none"></div>
                  </div>
                  <div style="font-size:10.5px;color:#2E2A2C;opacity:.5;margin-top:6px">Misma carga y reps en todas las series.</div>
                  <button onClick="{{ addSet }}" style="width:100%;margin-top:10px;padding:12px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:14px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">+ Añadir serie</button>
                </sc-if>
                <sc-if value="{{ isMultiMode }}" hint-placeholder-val="{{ false }}">
                  <div style="font-size:10.5px;color:#2E2A2C;opacity:.5;margin-bottom:8px">Carga y reps propias para cada serie.</div>
                  <div style="display:flex;flex-direction:column;gap:8px">
                    <sc-for list="{{ multiRowsView }}" as="row" hint-placeholder-count="2">
                      <div style="display:flex;align-items:center;gap:8px;animation:fadeSlideUp .25s ease both">
                        <div style="font-size:11px;color:#355070;width:46px;flex:none">Serie {{ row.n }}</div>
                        <input placeholder="kg" value="{{ row.weight }}" onChange="{{ row.setWeight }}" style="flex:1;min-width:0;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                        <input placeholder="reps" value="{{ row.reps }}" onChange="{{ row.setReps }}" style="flex:1;min-width:0;box-sizing:border-box;text-align:center;padding:8px 4px;border-radius:999px;border:1px solid #E4A3B3;background:#FFFFFF;font-size:13px;color:#2E2A2C;transition:border-color .15s ease" style-focus="border-color:#B56576;outline:none">
                        <div onClick="{{ row.remove }}" style="cursor:pointer;color:#B56576;font-size:16px;padding:2px 4px;transition:transform .12s ease" style-active="transform:scale(.8)">×</div>
                      </div>
                    </sc-for>
                    <div onClick="{{ addMultiRow }}" style="cursor:pointer;align-self:flex-start;font-size:12.5px;color:#B56576;font-weight:600;transition:opacity .15s ease" style-hover="opacity:.7">+ Añadir otra serie</div>
                    <button onClick="{{ saveMultiSession }}" style="width:100%;margin-top:2px;padding:12px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:14px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Guardar sesión</button>
                  </div>
                </sc-if>
              </div>
              <sc-if value="{{ justPr }}" hint-placeholder-val="{{ false }}">
                <div style="background:#355070;border-radius:14px;padding:10px 14px;font-size:12.5px;color:#F1FAEE;animation:prToast 2.6s ease both">🏆 ¡Nuevo récord personal!</div>
              </sc-if>
              <div>
                <div style="font-size:14px;font-weight:600;color:#2E2A2C;margin-bottom:8px">Historial reciente</div>
                <sc-if value="{{ hasHistory }}" hint-placeholder-val="{{ true }}">
                  <div style="display:flex;flex-direction:column;border-radius:16px;overflow:hidden;background:#FFFFFF">
                    <div style="display:flex;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#355070;opacity:.6;padding:10px 14px;border-bottom:1px solid #F1FAEE">
                      <div style="flex:1">Fecha</div><div style="flex:1">Carga</div><div style="flex:1">Reps×Ser</div>
                    </div>
                    <sc-for list="{{ historyRows }}" as="row" hint-placeholder-count="3">
                      <div style="display:flex;font-size:13px;color:#2E2A2C;padding:9px 14px;border-bottom:1px solid #F6E7E2;animation:fadeSlideUp .3s both">
                        <div style="flex:1">{{ row.date }}</div><div style="flex:1">{{ row.weightLabel }}</div><div style="flex:1">{{ row.repsSeries }}</div>
                      </div>
                    </sc-for>
                  </div>
                </sc-if>
                </div>
              <sc-if value="{{ hasHistory }}" hint-placeholder-val="{{ true }}">
                <div>
                  <div style="font-size:12px;color:#2E2A2C;opacity:.6;margin-bottom:8px">Progreso de carga</div>
                  <div style="display:flex;align-items:flex-end;gap:6px;height:70px">
                    <sc-for list="{{ bars }}" as="bar" hint-placeholder-count="6">
                      <div style="flex:1;height:100%;display:flex;align-items:flex-end">
                        <div style="width:100%;height:{{ bar.height }};background:{{ bar.color }};border-radius:6px 6px 0 0;transform-origin:bottom;animation:growUp .5s ease both"></div>
                      </div>
                    </sc-for>
                  </div>
                </div>
              </sc-if>
            </div>
          </div>
        </sc-if>

        <!-- CALENDAR TAB -->
        <sc-if value="{{ isCalendar }}" hint-placeholder-val="{{ false }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:14px">
            <div style="font-family:'Caprasimo',system-ui;font-size:24px;color:#2E2A2C;animation:fadeSlideUp .4s both">Mi semana</div>
            <div style="font-size:12.5px;color:#2E2A2C;opacity:.6;margin-top:-8px">Planifica qué entrenas cada día</div>
            <sc-for list="{{ days }}" as="day" hint-placeholder-count="7">
              <div style="background:#FFFFFF;border-radius:18px;padding:14px 16px;display:flex;flex-direction:column;gap:10px;animation:fadeSlideUp .35s both;border:{{ day.border }};box-sizing:border-box">
                <div style="display:flex;align-items:center;justify-content:space-between">
                  <div style="display:flex;align-items:center;gap:8px">
                    <div style="font-family:'Caprasimo',system-ui;font-size:15px;color:#2E2A2C">{{ day.label }}</div>
                    <sc-if value="{{ day.isToday }}" hint-placeholder-val="{{ false }}">
                      <div style="font-size:9px;padding:2px 8px;border-radius:999px;background:#F1FAEE;color:#355070;letter-spacing:.05em;text-transform:uppercase">Hoy</div>
                    </sc-if>
                  </div>
                  <div style="font-size:11px;color:#2E2A2C;opacity:.5">{{ day.count }} ejercicios</div>
                </div>
                <sc-if value="{{ day.list }}" hint-placeholder-val="{{ true }}">
                  <div style="display:flex;flex-wrap:wrap;gap:8px">
                    <sc-for list="{{ day.list }}" as="pex" hint-placeholder-count="2">
                      <div style="display:flex;align-items:center;gap:6px;background:#F6E7E2;border-radius:999px;padding:6px 8px 6px 14px;font-size:12px;color:#2E2A2C;animation:popIn .25s ease both">
                        {{ pex.name }}
                        <div onClick="{{ pex.remove }}" style="cursor:pointer;color:#B56576;font-size:13px;line-height:1;padding:2px;transition:transform .12s ease" style-active="transform:scale(.8)">×</div>
                      </div>
                    </sc-for>
                  </div>
                </sc-if>
                <div onClick="{{ day.togglePicker }}" style="cursor:pointer;align-self:flex-start;font-size:12.5px;color:#B56576;font-weight:600;padding:4px 0;transition:opacity .15s ease" style-hover="opacity:.7" style-active="transform:scale(.97)">
                  {{ day.pickerLabel }}
                </div>
                <sc-if value="{{ day.pickerOpen }}" hint-placeholder-val="{{ false }}">
                  <div style="max-height:180px;overflow-y:auto;background:#F6E7E2;border-radius:14px;padding:6px;display:flex;flex-direction:column;gap:2px;animation:fadeSlideUp .25s ease both">
                    <sc-for list="{{ day.pickerItems }}" as="pi" hint-placeholder-count="6">
                      <div onClick="{{ pi.add }}" style="cursor:pointer;padding:8px 10px;border-radius:10px;display:flex;justify-content:space-between;align-items:center;transition:background .12s ease" style-hover="background:#FFFFFF">
                        <span style="font-size:13px;color:#2E2A2C">{{ pi.name }}</span>
                        <span style="font-size:10px;color:#355070;opacity:.7">{{ pi.groupName }}</span>
                      </div>
                    </sc-for>
                  </div>
                </sc-if>
              </div>
            </sc-for>
          </div>
        </sc-if>

        <!-- PROGRESS TAB -->
        <sc-if value="{{ isProgress }}" hint-placeholder-val="{{ false }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:14px">
            <div style="font-family:'Caprasimo',system-ui;font-size:24px;color:#2E2A2C;animation:fadeSlideUp .4s both">Récords</div>
            <sc-if value="{{ hasPrs }}" hint-placeholder-val="{{ true }}">
              <sc-for list="{{ prList }}" as="pr" hint-placeholder-count="3">
                <div style="background:#FFFFFF;border-radius:18px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;animation:fadeSlideUp .35s both">
                  <div>
                    <div style="font-family:'Caprasimo',system-ui;font-size:15px;color:#2E2A2C">{{ pr.name }}</div>
                    <div style="font-size:11px;color:#2E2A2C;opacity:.55">{{ pr.machine }}</div>
                  </div>
                  <div style="text-align:right">
                    <div style="font-size:17px;font-weight:700;color:#B56576">{{ pr.weightLabel }}</div>
                    <div style="font-size:11px;color:#355070">{{ pr.repsSeries }}</div>
                  </div>
                </div>
              </sc-for>
            </sc-if>
            <sc-if value="{{ hasPrsInverse }}" hint-placeholder-val="{{ false }}">
              <div style="background:#FFFFFF;border-radius:18px;padding:24px;text-align:center;font-size:13px;color:#2E2A2C;opacity:.6">Registra tu primera serie para ver récords aquí.</div>
            </sc-if>
          </div>
        </sc-if>

        <!-- PROFILE TAB -->
        <sc-if value="{{ isProfile }}" hint-placeholder-val="{{ false }}">
          <div style="padding:8px 24px 28px;display:flex;flex-direction:column;gap:16px">
            <div style="font-family:'Caprasimo',system-ui;font-size:24px;color:#2E2A2C;animation:fadeSlideUp .4s both">Perfil</div>
            <div style="background:#FFFFFF;border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:4px;animation:fadeSlideUp .4s both">
              <div style="font-family:'Caprasimo',system-ui;font-size:16px;color:#2E2A2C">{{ profile.name }}</div>
              <div style="font-size:12px;color:#2E2A2C;opacity:.55">{{ profileSummary }}</div>
            </div>
            <div style="background:#F1FAEE;border-radius:18px;padding:14px 16px;display:flex;align-items:center;gap:10px;font-size:12.5px;color:#355070;animation:fadeSlideUp .4s .05s both">
              <span>●</span> Todos tus datos se guardan en tu dispositivo</div>
            <div style="animation:fadeSlideUp .4s .1s both">
              <div style="font-size:13px;font-weight:600;color:#2E2A2C;margin-bottom:8px">Unidad de peso</div>
              <div style="display:inline-flex;border-radius:999px;background:#FFFFFF;padding:4px">
                <div onClick="{{ setUnitKg }}" style="padding:7px 18px;border-radius:999px;font-size:12.5px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ unitKgBg }};color:{{ unitKgColor }}">kg</div>
                <div onClick="{{ setUnitLb }}" style="padding:7px 18px;border-radius:999px;font-size:12.5px;cursor:pointer;transition:background .15s ease,color .15s ease;background:{{ unitLbBg }};color:{{ unitLbColor }}">lb</div>
              </div>
            </div>
            <div style="background:#FFFFFF;border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:10px;animation:fadeSlideUp .4s .15s both">
              <div style="font-size:13px;font-weight:600;color:#2E2A2C">Ver mi progreso en otro dispositivo</div>
              <div style="font-size:11.5px;color:#2E2A2C;opacity:.6;line-height:1.5">Genera un archivo con todo tu progreso y ábrelo tu otro dispositivo para continuar donde lo dejaste.</div>
              <div style="display:flex;gap:8px">
                <button onClick="{{ exportProgress }}" style="flex:1;padding:11px;border-radius:999px;border:none;background:#B56576;color:#FFFFFF;font-family:'Figtree';font-weight:600;font-size:12.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#9c4f60" style-active="transform:scale(.97)">Exportar archivo</button>
                <button onClick="{{ triggerImport }}" style="flex:1;padding:11px;border-radius:999px;border:1.5px solid #355070;background:transparent;color:#355070;font-family:'Figtree';font-weight:600;font-size:12.5px;cursor:pointer;transition:background .15s ease,transform .12s ease" style-hover="background:#F1FAEE" style-active="transform:scale(.97)">Importar archivo</button>
              </div>
              <input type="file" accept="application/json,.json" ref="{{ fileInputRef }}" onChange="{{ handleImportFile }}" style="display:none">
              <sc-if value="{{ transferMsg }}" hint-placeholder-val="{{ false }}">
                <div style="font-size:12px;color:#355070;background:#F1FAEE;border-radius:12px;padding:8px 12px;animation:popIn .25s ease both">{{ transferMsg.text }}</div>
              </sc-if>
            </div>
            <div onClick="{{ replayTutorial }}" style="cursor:pointer;align-self:flex-start;font-size:12px;color:#355070;opacity:.6;text-decoration:underline;transition:opacity .15s ease" style-hover="opacity:.9">Ver tutorial de nuevo</div>
          </div>
        </sc-if>

        </sc-if>

      </div>

      <sc-if value="{{ isNormalTabs }}" hint-placeholder-val="{{ true }}">
      <div style="display:flex;flex:none;padding-top:6px;background:#F6E7E2">
        <div onClick="{{ goHome }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 0 16px;font-size:10px;cursor:pointer;color:{{ tabColorHome }};transition:color .2s ease" style-active="transform:scale(.92)">
          <span style="font-size:16px">⌂</span>Inicio
        </div>
        <div onClick="{{ goExercises }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 0 16px;font-size:10px;cursor:pointer;color:{{ tabColorExercises }};transition:color .2s ease" style-active="transform:scale(.92)">
          <span style="font-size:16px">▤</span>Ejercicios
        </div>
        <div onClick="{{ goCalendar }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 0 16px;font-size:10px;cursor:pointer;color:{{ tabColorCalendar }};transition:color .2s ease" style-active="transform:scale(.92)">
          <span style="font-size:16px">▦</span>Calendario
        </div>
        <div onClick="{{ goProgress }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 0 16px;font-size:10px;cursor:pointer;color:{{ tabColorProgress }};transition:color .2s ease" style-active="transform:scale(.92)">
          <span style="font-size:16px">◱</span>Progreso
        </div>
        <div onClick="{{ goProfile }}" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 0 16px;font-size:10px;cursor:pointer;color:{{ tabColorProfile }};transition:color .2s ease" style-active="transform:scale(.92)">
          <span style="font-size:16px">◯</span>Perfil
        </div>
      </div>
      </sc-if>

    </div>
  </div>
</div>

</x-dc>
